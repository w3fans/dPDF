#!/usr/bin/env bash
# Copy to ops/project.env and adjust for the real server.

PROJECT_NAME="dPDF"
PROJECT_FAMILY="app"
PROJECT_ID="project:dpdf"
PRODUCT_ID="product:dpdf"
COPY_ID=""
REPOSITORY_ID=""
DEPLOYMENT_ID=""
PROJECT_COPY_ROLE="active-source"
# Web Git authority uses server-source. Mobile/app Git authority uses
# build-release; source folders must never use either role.
PROJECT_LIVE_URL=""
PROJECT_DEPLOY_HOST=""
PROJECT_REMOTE_SRC_PATH=""
PROJECT_REMOTE_APP_PATH=""
PROJECT_REMOTE_API_PATH=""
PROJECT_RELEASE_MODE_DEFAULT="patch"
PROJECT_PROTECTED_DEPLOY_PATHS=""
PROJECT_SOURCE_EXCLUDE_FILE=""

# S5 remains disabled until this individual project is registered and tested.
S5_INTEGRATION_MODE="disabled"
S5_FACTORY_ENABLED="0"
S5_BASE_URL=""
S5_API_PREFIX="/api/v1"
S5_TOKEN_FILE=""

# Change to enforce only after SEMANTIC.json has a reviewed proposal receipt
# and generated.json has been created from the current source.
PROJECT_REFERENCE_MODE="disabled"

# Local standard checkpoint transport and app Git authority (adapt on other hosts).
DPDF_RELEASE_CHECKOUT="/app/dPDF/source"
DPDF_RELEASE_TARGET="backup-user@release-host::app/dPDF/source/"
DPDF_CARGO="/path/to/configured-remote-cargo-wrapper"
